<?xml version="1.0" ?>
<!DOCTYPE profile>
<profile
    xmlns="http://www.suse.com/1.0/yast2ns"
    xmlns:config="http://www.suse.com/1.0/configns"
>
  <software>
    <products config:type="list">
      <product>PRODUCT</product>
    </products>
  </software>

  <scripts>
    <pre-scripts config:type="list">
      <script>
        <filename>set-product.sh</filename>
        <source><![CDATA[#!/bin/bash
        sed -e "s/PRODUCT/Tumbleweed/" /tmp/profile/autoinst.xml > /tmp/profile/modified.xml
]]></source>
      </script>
    </pre-scripts>
    <chroot-scripts config:type="list">
      <script>
        <filename>enable-ssh.sh</filename>
        <chrooted config:type="boolean">true</chrooted>
	<source><![CDATA[#!/bin/bash\nsystemctl enable sshd]]></source>
      </script>
    </chroot-scripts>
  </scripts>
</profile>
